=== systemctl cat kiosky-player.service (+ drop-ins) ===
# /etc/systemd/system/kiosky-player.service
[Unit]
Description=Kiosky Player
After=network-online.target totem-firstboot-gate.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=totem
Group=totem
WorkingDirectory=/opt/totem/kiosky-player
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=XDG_RUNTIME_DIR=/tmp/kiosky
Environment=KIOSKY_RUNTIME_DIR=/tmp/kiosky
Environment=KIOSKY_LAUNCHER_STATUS_FILE=/data/state/kiosky-player/launcher-status.json
ExecStartPre=+/usr/bin/install -d -o totem -g totem -m 0750 /tmp/kiosky /data/state/kiosky-player
ExecStartPre=+/opt/totem/bin/totem_visual_tty_guard.sh --quiet --tty 1 --tty 2
ExecStart=/usr/bin/env bash /opt/totem/bin/kiosky_service_launcher.sh
Restart=always
RestartSec=10s
UMask=0077
ReadOnlyPaths=/opt/totem
ReadWritePaths=/data /tmp

[Install]
WantedBy=multi-user.target

# /etc/systemd/system/kiosky-player.service.d/20-dadooh-launcher.conf
# C14.1.1 — Redirect kiosky-player.service ExecStart through our wrapper.
#
# Why: the wrapper picks /data/apps/kiosky-player/current/kiosk.py if present,
# falling back to /opt/totem/kiosky-player/kiosk.py otherwise.  The wrapper then
# delegates to the original inner launcher (kiosky_service_launcher.sh) via
# `exec`, so the watchdog/status writer/setup-trigger plumbing is preserved.
#
# Notes:
#   - ExecStart is reset first because systemd drop-ins must clear list options
#     before re-defining them.
#   - We do NOT touch User, Group, WorkingDirectory, Environment, ReadOnlyPaths,
#     ReadWritePaths, or any of the ExecStartPre lines from the base unit.
#   - The wrapper at /opt/totem/bin/totem-kiosky-launcher.sh must be in place
#     before this drop-in is loaded.  Bootstrap installs it.

[Service]
ExecStart=
ExecStart=/usr/bin/env bash /opt/totem/bin/totem-kiosky-launcher.sh

=== systemctl cat totem-settings-trigger.service ===
# /etc/systemd/system/totem-settings-trigger.service
[Unit]
Description=Dadooh Totem Settings Trigger
After=systemd-udevd.service local-fs.target totem-firstboot-gate.service
Wants=systemd-udevd.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/totem/bin/totem_settings_trigger.py --daemon --request-dir /run/dadooh-settings --hold-sec 5 --cooldown-sec 10 --session-lock /run/totem/settings-session.lock --open-service totem-open-settings.service --tty-guard /opt/totem/bin/totem_visual_tty_guard.sh --visual-tty 2
Restart=always
RestartSec=2
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target

=== systemctl cat totem-open-settings.service ===
# /etc/systemd/system/totem-open-settings.service
[Unit]
Description=Dadooh Open Totem Settings
After=kiosky-player.service totem-settings-trigger.service

[Service]
Type=oneshot
TimeoutStartSec=0
TimeoutStopSec=20s
KillSignal=SIGTERM
KillMode=control-group
ExecStartPre=/opt/totem/bin/totem_visual_tty_guard.sh --clear --tty 2
ExecStartPre=/opt/totem/bin/totem_settings_lab_apply_policy.sh --enable-from-homologation-seed-if-present --seed-path /data/state/totem-settings/private-values.seed.json --policy-path /run/dadooh-settings/apply-policy.json --request-dir /run/dadooh-settings
ExecStart=/opt/totem/bin/totem_open_settings_session.sh --mode interactive --expect any --tty 2 --timeout-sec 7200 --out-dir /tmp/dadooh-c10-6-2-open-settings/session --wizard-out-dir /tmp/dadooh-c10-6-2-visual-wizard --handoff-out-dir /tmp/dadooh-c10-6-2-handoff --writer-out-dir /tmp/dadooh-c10-6-2-writer --apply-policy-path /run/dadooh-settings/apply-policy.json --request-dir /run/dadooh-settings --lock-dir /run/totem/settings-session.lock --apply-mode policy --private-settings-context-path /data/state/totem-settings/last-settings.json
ExecStopPost=/opt/totem/bin/totem_open_settings_cleanup.sh --reason service-stop-post --request-dir /run/dadooh-settings --lock-dir /run/totem/settings-session.lock --tty 2
StandardOutput=null
StandardError=null

=== systemctl cat dadooh-visual-splash.service ===
# /etc/systemd/system/dadooh-visual-splash.service
[Unit]
Description=Dadooh visual boot splash
DefaultDependencies=no
After=local-fs.target
Before=basic.target getty.target kiosky-player.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/opt/totem/bin/totem_visual_tty_guard.sh --clear --tty 2
ExecStart=/usr/local/sbin/dadooh-visual-splash.py boot
ExecStop=/usr/local/sbin/dadooh-visual-splash.py shutdown
TimeoutSec=8
StandardOutput=null
StandardError=null

[Install]
WantedBy=sysinit.target

=== systemctl cat totem-firstboot-gate.service ===
# /etc/systemd/system/totem-firstboot-gate.service
[Unit]
Description=Dadooh Image-Lab Firstboot Gate
Documentation=man:systemd.service(5)
DefaultDependencies=no
After=local-fs.target systemd-remount-fs.service
Before=dadooh-visual-splash.service kiosky-player.service totem-settings-trigger.service
ConditionPathExists=/root/.not_logged_in_yet

[Service]
Type=oneshot
TimeoutStartSec=0
ExecStart=/opt/totem/bin/totem_firstboot_gate.sh --wait --tty 2
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target

=== getty@tty1 unit ===
# /lib/systemd/system/getty@.service
#  SPDX-License-Identifier: LGPL-2.1-or-later
#
#  This file is part of systemd.
#
#  systemd is free software; you can redistribute it and/or modify it
#  under the terms of the GNU Lesser General Public License as published by
#  the Free Software Foundation; either version 2.1 of the License, or
#  (at your option) any later version.

[Unit]
Description=Getty on %I
Documentation=man:agetty(8) man:systemd-getty-generator(8)
Documentation=https://0pointer.de/blog/projects/serial-console.html
After=systemd-user-sessions.service plymouth-quit-wait.service getty-pre.target
After=rc-local.service

# If additional gettys are spawned during boot then we should make
# sure that this is synchronized before getty.target, even though
# getty.target didn't actually pull it in.
Before=getty.target
IgnoreOnIsolate=yes

# IgnoreOnIsolate causes issues with sulogin, if someone isolates
# rescue.target or starts rescue.service from multi-user.target or
# graphical.target.
Conflicts=rescue.service
Before=rescue.service

# On systems without virtual consoles, don't start any getty. Note
# that serial gettys are covered by serial-getty@.service, not this
# unit.
ConditionPathExists=/dev/tty0

[Service]
# the VT is cleared by TTYVTDisallocate
# The '-o' option value tells agetty to replace 'login' arguments with an
# option to preserve environment (-p), followed by '--' for safety, and then
# the entered username.
ExecStart=-/sbin/agetty -o '-p -- \\u' --noclear - $TERM

