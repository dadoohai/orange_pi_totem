# Raw board diagnostic artifacts may contain IPs, hostnames, SSIDs and UUIDs.
docs/evidence/candidate-a/runs/**/*.tar.gz
docs/evidence/candidate-a/runs/**/extracted/
docs/evidence/candidate-a/runs/**/raw/

# Builder-side ephemeral logs from deploy scripts (may contain device IPs).
.cache/

# Local simulation sandboxes are reproducible runtime state.
.sim/

# App-update package outputs: keep manifest in git, but tarballs are large and
# already authoritative on GitHub Releases.
releases/app-updates/**/*.tar.gz

# Python bytecode caches (build artifacts; regenerated automatically).
__pycache__/
*.pyc
