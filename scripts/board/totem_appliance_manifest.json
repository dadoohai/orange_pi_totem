    "branch": "foundation-v0.1",
    "manifest_created_from_head": "dynamic_at_install_time",
    "install_commit_policy": "record git rev-parse HEAD from the repo copy used by the installer"
  },
  "runtime": {
    "required_commands": [
      "python3",
      "mpv",
      "ffmpeg",
      "nmcli"
    ],
    "required_debian_packages": [
      "mpv",
      "ffmpeg",
      "python3-requests",
      "network-manager"
    ],
    "forbidden_packages": [
      "xserver-xorg",
      "chromium",
      "chromium-browser",
      "weston"
    ],
    "forbidden_commands": [
      "Xorg",
      "chromium",
      "chromium-browser",
      "weston"
    ],
    "install_requires_explicit_flag": true,
    "apt_upgrade_allowed": false,
    "apt_full_upgrade_allowed": false,
    "armbian_upgrade_allowed": false
  },
  "read_only_prerequisites": {
    "required_commands": [
      "overlayroot-chroot"
    ],
    "required_files": [
      "/usr/share/initramfs-tools/scripts/init-bottom/overlayroot"
    ],
    "required_debian_packages": [
      "overlayroot"
    ],
    "install_requires_explicit_flag": true,
    "install_flag": "--install-readonly-prereqs",
    "apt_install_policy": "apt-get install --no-upgrade --no-install-recommends exact packages only",
    "apt_upgrade_allowed": false,
    "apt_full_upgrade_allowed": false,
    "armbian_upgrade_allowed": false,
    "enable_read_only_during_install": false,
    "final_image_must_include": true
  },
  "users": {
    "totem": {
      "user": "totem",
      "group": "totem",
      "system": true,
      "home": "/nonexistent",
      "shell": "nologin",
      "supplementary_groups_if_present": [
        "audio",
        "video",
        "render"
      ]
    }
  },
  "paths": [
    {"path": "/opt/totem", "type": "dir", "owner": "root", "group": "root", "mode": "0755"},
    {"path": "/opt/totem/bin", "type": "dir", "owner": "root", "group": "root", "mode": "0755"},
    {"path": "/opt/totem/share", "type": "dir", "owner": "root", "group": "root", "mode": "0755"},
    {"path": "/opt/totem/kiosky-player", "type": "dir", "owner": "root", "group": "root", "mode": "0755"},
    {"path": "/data", "type": "dir", "owner": "root", "group": "root", "mode": "0755"},
    {"path": "/data/config", "type": "dir", "owner": "totem", "group": "totem", "mode": "0750"},
    {"path": "/data/media", "type": "dir", "owner": "root", "group": "root", "mode": "0755"},
    {"path": "/data/media/kiosky-player", "type": "dir", "owner": "totem", "group": "totem", "mode": "0750"},
    {"path": "/data/state", "type": "dir", "owner": "root", "group": "root", "mode": "0755"},
    {"path": "/data/state/kiosky-player", "type": "dir", "owner": "totem", "group": "totem", "mode": "0750"},
    {"path": "/data/state/totem-appliance", "type": "dir", "owner": "root", "group": "root", "mode": "0755"},
    {"path": "/data/state/totem-display", "type": "dir", "owner": "root", "group": "root", "mode": "0700", "runtime_state": true, "content_policy": "public_orientation_file_allowlisted_no_directory_hash"},
    {"path": "/data/state/totem-boot-visual", "type": "dir", "owner": "root", "group": "root", "mode": "0700", "runtime_state": true, "content_policy": "rollback_state_no_directory_hash"},
    {"path": "/data/state/totem-settings", "type": "dir", "owner": "root", "group": "root", "mode": "0700", "runtime_state": true, "content_policy": "private_settings_context_no_content_read"},
    {"path": "/data/spool", "type": "dir", "owner": "root", "group": "root", "mode": "0755"},
    {"path": "/data/spool/kiosky-player", "type": "dir", "owner": "totem", "group": "totem", "mode": "0750"},
    {"path": "/data/logs", "type": "dir", "owner": "root", "group": "root", "mode": "0755"},
