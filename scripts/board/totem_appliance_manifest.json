    {"source": "scripts/board/totem_wifi_nm_adapter.py", "target": "/opt/totem/bin/totem_wifi_nm_adapter.py", "owner": "root", "group": "root", "mode": "0755"},
    {"source": "scripts/board/verify_totem_read_only_policy.sh", "target": "/opt/totem/bin/verify_totem_read_only_policy.sh", "owner": "root", "group": "root", "mode": "0755"},
    {"source": "scripts/board/totem_updatectl.py", "target": "/opt/totem/bin/totem-updatectl", "owner": "root", "group": "root", "mode": "0755"},
    {"source": "scripts/board/totem-kiosky-launcher.sh", "target": "/opt/totem/bin/totem-kiosky-launcher.sh", "owner": "root", "group": "root", "mode": "0755"}
  ],
  "extra_files": [
    {"source": "scripts/board/totem_visual_splash.py", "target": "/usr/local/sbin/dadooh-visual-splash.py", "owner": "root", "group": "root", "mode": "0755"},
    {"source": "scripts/board/totem_read_only_policy.json", "target": "/opt/totem/share/totem_read_only_policy.json", "owner": "root", "group": "root", "mode": "0644"},
    {"source": "scripts/board/systemd/kiosky-player.service.d/20-dadooh-launcher.conf", "target": "/etc/systemd/system/kiosky-player.service.d/20-dadooh-launcher.conf", "owner": "root", "group": "root", "mode": "0644"}
  ],
  "systemd_units": [
    {"source": "scripts/board/kiosky-player.service", "target": "/etc/systemd/system/kiosky-player.service", "enabled": true, "active_expected_on_dev": "active"},
    {"source": "scripts/board/totem-visual-tty-guard.service", "target": "/etc/systemd/system/totem-visual-tty-guard.service", "enabled": true, "active_expected_on_dev": "active"},
    {"source": "scripts/board/totem-firstboot-gate.service", "target": "/etc/systemd/system/totem-firstboot-gate.service", "enabled": true, "active_expected_on_dev": "inactive"},
    {"source": "scripts/board/totem-settings-trigger.service", "target": "/etc/systemd/system/totem-settings-trigger.service", "enabled": true, "active_expected_on_dev": "active"},
    {"source": "scripts/board/totem-open-settings.service", "target": "/etc/systemd/system/totem-open-settings.service", "enabled": false, "enabled_state": "static", "active_expected_on_dev": "inactive"},
    {"source": "scripts/board/dadooh-visual-splash.service", "target": "/etc/systemd/system/dadooh-visual-splash.service", "enabled": true, "active_expected_on_dev": "active"},
    {"source": "scripts/board/systemd/totem-update-agent.service", "target": "/etc/systemd/system/totem-update-agent.service", "enabled": false, "enabled_state": "static", "active_expected_on_dev": "inactive"},
    {"source": "scripts/board/systemd/totem-update-agent.timer", "target": "/etc/systemd/system/totem-update-agent.timer", "enabled": true, "active_expected_on_dev": "active"}
  ],
  "boot_visual_guardrails": {
    "armbian_env": "/boot/armbianEnv.txt",
    "backup_state_dir": "/data/state/totem-boot-visual",
    "set_keys": {
      "console": "serial",
      "verbosity": "0"
    },
    "required_extraargs_tokens": [
      "quiet",
      "loglevel=0",
      "systemd.show_status=false",
      "rd.systemd.show_status=false",
      "logo.nologo",
      "vt.global_cursor_default=0"
    ],
    "getty_units_disabled": [
      "getty@tty1.service",
      "getty@tty2.service"
    ],
    "firstboot_gate": {
      "reserved_tty": "tty2",
      "raw_tty_output_allowed": false,
      "renderer_failure_fallback": "clear_reserved_vt_without_text"
    },
    "visual_tty_guard": {
      "reserved_ttys": [
        "tty1",
        "tty2"
      ],
      "hold_ttys_open": true,
      "keyboard_echo_allowed": false,
      "must_start_before": [
        "kiosky-player.service",
        "totem-settings-trigger.service",
        "totem-open-settings.service"
      ]
    }
  },
  "public_orientation": {
    "path": "/data/state/totem-display/orientation.json",
    "schema_version": "dadooh-display-orientation.v1",
    "owner": "root",
    "group": "root",
    "mode": "0644",
    "allowed_fields": [
      "schema_version",
      "updated_at",
      "rotation_deg",
      "orientation_label"
    ],
    "allowed_rotation_deg": [
      0,
      90,
      180,
      270
    ],
    "default_if_missing": {
      "rotation_deg": 0,
      "orientation_label": "landscape"
    },
    "must_not_read_private_config": true
  },
  "wifi_setup_ux": {
    "visual_wizard": "/opt/totem/bin/totem_setup_visual_wizard.py",
    "adapter": "/opt/totem/bin/totem_wifi_nm_adapter.py",
    "paginated_wifi_list": true,
    "auto_refresh_interval_sec": 10,
    "manual_refresh_key": "R",
    "sorted_by_signal_desc": true,
    "duplicate_ssid_grouping": true,
    "signal_percent_visible": true,
    "signal_bars_visible": true,
    "signal_bucket_visible": true,
    "password_hidden_by_default": true,
    "password_show_toggle_key": "F2",
    "password_show_toggle_fallback_key": "Ctrl+P",
    "public_status_must_not_include": [
      "ssid",
      "wifi_password",
      "bssid",
      "mac",
      "ip",
      "dns"
    ]
  },
  "wizard_ux_redraw_startup_feedback": {
    "visual_wizard": "/opt/totem/bin/totem_setup_visual_wizard.py",
    "visual_splash": "/opt/totem/bin/totem_visual_splash.py",
    "wizard_text_panel_max_items": 3,
    "wizard_subtitle_max_lines": 1,
    "input_render_debounce_sec": 0.1,
    "input_repeat_drain_sec": 0.035,
    "input_max_render_rate_fps": 12,
    "backspace_repeats_coalesced": true,
    "password_hidden_by_default": true,
    "password_show_toggle_key": "F2",
    "password_show_toggle_fallback_key": "Ctrl+P",
    "startup_feedback_modes": [
      "boot",
      "player",
      "setup",
      "saving",
      "config_pending"
    ],
    "player_start_splash": true,
    "config_pending_splash": true,
    "public_status_must_not_include": [
      "ssid",
      "wifi_password",
      "bssid",
      "mac",
      "ip",
      "dns"
    ]
  },
  "ai_ui_ux_review": {
    "qa_generator": "scripts/qa/generate_ui_ux_gallery.py",
    "manual_interaction_required": false,
    "operator_keypress_required": false,
    "gallery_uses_synthetic_data_only": true,
    "ai_visual_review_performed": false,
    "heuristic_review_performed": true,
    "human_review_required": true,
    "hdmi_capture_required_for_final_perception": true,
    "public_status_must_not_include": [
      "ssid",
      "wifi_password",
      "bssid",
      "mac",
      "ip",
      "dns"
    ]
  },
  "kiosky_player": {
    "install_path": "/opt/totem/kiosky-player",
    "repo_full_name": "dadoohai/kiosky-player",
    "repository_url": "https://github.com/dadoohai/kiosky-player.git",
    "expected_repo": "dadoohai/kiosky-player",
    "expected_ref": "appliance-v0.1",
    "expected_commit": "c71318a64c08e47b8426f1388b95f21364d57123",
    "expected_commit_short": "c71318a",
    "expected_commit_title": "Add configurable MPV output flags",
    "pin_status": "PINNED",
    "pin_source": "docs/releases/v0.1-rc1-homologacao/PROVISIONAMENTO_SEGUNDA_PLACA.md and local /home/builder/kiosky-player commit lookup",
    "expected_git_metadata_on_dev": false,
    "dev_tree_without_git_metadata_policy": "accepted_with_documented_pin; exact installed tree commit is not machine-verifiable without changing the app tree",
    "second_board_install_policy": "deploy/export from expected_repo expected_ref expected_commit, excluding .git, private config, media cache and secrets",
    "action_required": "C10.9 must deploy kiosky-player from this exact commit before final verify on the second board"
  },
  "private_or_field_provisioned_files": [
    "/data/config/config.json",
    "/data/config/*.bak",
    "/data/media/**",
    "/data/logs/**",
    "/data/state/kiosky-player/**",
    "/data/state/totem-settings/last-settings.json",
    "/run/dadooh-settings/*.json",
    "/run/dadooh-settings/session.lock",
    "NetworkManager Wi-Fi profiles, SSID, passwords, IP, MAC, DNS and gateway"
  ],
  "never_embed": [
    "api_key",
    "api_url real",
    "environment_id real",
    "station_id",
    "SSID",
    "Wi-Fi password",
    "IP",
    "MAC",
    "DNS",
    "gateway",
    "hostname",
    "config real",
    "backups",
    "raw logs",
    "media cache",
    "private candidate files"
  ]
}
