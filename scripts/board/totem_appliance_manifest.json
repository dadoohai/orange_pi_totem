    {"source": "scripts/board/totem_config_contract_validate.py", "target": "/opt/totem/bin/totem_config_contract_validate.py", "owner": "root", "group": "root", "mode": "0755"},
    {"source": "scripts/board/totem_config_writer_real.py", "target": "/opt/totem/bin/totem_config_writer_real.py", "owner": "root", "group": "root", "mode": "0755"},
