{
  "schema_version": "dadooh-totem-appliance-manifest.v1",
  "created_for": "C10.8.1 (extended by C14.2.1)",
  "orange_pi_totem": {
    "repository": "dadoohai/orange_pi_totem",
    "branch": "foundation-v0.1",
    "manifest_created_from_head": "dynamic_at_install_time",
    "install_commit_policy": "record git rev-parse HEAD from the repo copy used by the installer"
  },
  "runtime": {
    "required_commands": [
      "python3",
      "mpv",
      "ffmpeg",
      "nmcli"
    ],
    "required_debian_packages": [
      "mpv",
      "ffmpeg",
      "python3-requests",
      "network-manager"
    ],
    "forbidden_packages": [
      "xserver-xorg",
      "chromium",
      "chromium-browser",
      "weston"
    ],
    "forbidden_commands": [
      "Xorg",
      "chromium",
      "chromium-browser",
      "weston"
    ],
    "install_requires_explicit_flag": true,
    "apt_upgrade_allowed": false,
    "apt_full_upgrade_allowed": false,
    "armbian_upgrade_allowed": false
  },
  "read_only_prerequisites": {
    "required_commands": [
      "overlayroot-chroot"
    ],
    "required_files": [
      "/usr/share/initramfs-tools/scripts/init-bottom/overlayroot"
    ],
    "required_debian_packages": [
      "overlayroot"
    ],
    "install_requires_explicit_flag": true,
    "install_flag": "--install-readonly-prereqs",
    "apt_install_policy": "apt-get install --no-upgrade --no-install-recommends exact packages only",
    "apt_upgrade_allowed": false,
    "apt_full_upgrade_allowed": false,
    "armbian_upgrade_allowed": false,
    "enable_read_only_during_install": false,
    "final_image_must_include": true
