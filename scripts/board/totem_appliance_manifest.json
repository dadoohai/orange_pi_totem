    {"path": "/data/state/totem-appliance", "type": "dir", "owner": "root", "group": "root", "mode": "0755"},
    {"path": "/data/state/totem-display", "type": "dir", "owner": "root", "group": "root", "mode": "0700", "runtime_state": true, "content_policy": "public_orientation_file_allowlisted_no_directory_hash"},
    {"path": "/data/state/totem-boot-visual", "type": "dir", "owner": "root", "group": "root", "mode": "0700", "runtime_state": true, "content_policy": "rollback_state_no_directory_hash"},
    {"path": "/data/state/totem-settings", "type": "dir", "owner": "root", "group": "root", "mode": "0700", "runtime_state": true, "content_policy": "private_settings_context_no_content_read"},
    {"path": "/data/spool", "type": "dir", "owner": "root", "group": "root", "mode": "0755"},
    {"path": "/data/spool/kiosky-player", "type": "dir", "owner": "totem", "group": "totem", "mode": "0750"},
    {"path": "/data/logs", "type": "dir", "owner": "root", "group": "root", "mode": "0755"},
    {"path": "/data/logs/kiosky-player", "type": "dir", "owner": "totem", "group": "totem", "mode": "0750"},
    {"path": "/tmp/kiosky", "type": "dir", "owner": "totem", "group": "totem", "mode": "0750"},
    {"path": "/run/dadooh-settings", "type": "dir", "owner": "root", "group": "root", "mode": "0700"},
