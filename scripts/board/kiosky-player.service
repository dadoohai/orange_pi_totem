[Unit]
Description=Kiosky Player
After=network-online.target totem-firstboot-gate.service totem-visual-tty-guard.service
Wants=network-online.target totem-visual-tty-guard.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=totem
Group=totem
WorkingDirectory=/opt/totem/kiosky-player
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=XDG_RUNTIME_DIR=/tmp/kiosky
Environment=KIOSKY_RUNTIME_DIR=/tmp/kiosky
Environment=KIOSKY_LAUNCHER_STATUS_FILE=/data/state/kiosky-player/launcher-status.json
ExecStartPre=+/usr/bin/install -d -o totem -g totem -m 0750 /tmp/kiosky /data/state/kiosky-player
ExecStartPre=+/opt/totem/bin/totem_visual_tty_guard.sh --quiet --tty 1 --tty 2
ExecStart=/usr/bin/env bash /opt/totem/bin/kiosky_service_launcher.sh
Restart=always
RestartSec=10s
UMask=0077
ReadOnlyPaths=/opt/totem
ReadWritePaths=/data /tmp

[Install]
WantedBy=multi-user.target
