[Unit]
Description=Dadooh Open Totem Settings
After=kiosky-player.service totem-settings-trigger.service

[Service]
Type=oneshot
TimeoutStartSec=0
TimeoutStopSec=20s
KillSignal=SIGTERM
KillMode=control-group
ExecStart=/opt/totem/bin/totem_open_settings_session.sh --mode interactive --expect any --tty 2 --timeout-sec 7200 --out-dir /tmp/dadooh-c10-6-2-open-settings/session --wizard-out-dir /tmp/dadooh-c10-6-2-visual-wizard --handoff-out-dir /tmp/dadooh-c10-6-2-handoff --writer-out-dir /tmp/dadooh-c10-6-2-writer --private-values /tmp/dadooh-c10-6-2-private/private-values.json --apply-policy-path /run/dadooh-settings/apply-policy.json --apply-mode real-write --private-source active-config --confirm-active-config-private-source --confirm-local-operator-save --private-settings-context-path /data/state/totem-settings/last-settings.json
ExecStopPost=/opt/totem/bin/totem_open_settings_cleanup.sh --reason service-stop-post --request-dir /run/dadooh-settings --lock-dir /run/dadooh-settings/session.lock --tty 2
StandardOutput=null
StandardError=null
