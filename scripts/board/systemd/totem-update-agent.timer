[Unit]
Description=Periodic dadooh totem app update check
Documentation=https://github.com/dadoohai/orange_pi_totem

[Timer]
# Conservative cadence for shipping homologation lot (C14.2.1):
#   - first run 10 minutes after boot so the player settles first;
#   - then once every 6 hours while the device is running;
#   - +/- 10 minutes of jitter so a lot of devices don't hit GitHub together.
OnBootSec=10min
OnUnitActiveSec=6h
RandomizedDelaySec=10min
# If the timer missed firings while the device was off, run once on next boot.
Persistent=true
Unit=totem-update-agent.service

[Install]
WantedBy=timers.target
