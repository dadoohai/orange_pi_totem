[Unit]
Description=Dadooh Totem Player Runtime Update Agent (production exact-target auto-pull)
Documentation=https://github.com/dadoohai/orange_pi_totem
After=network-online.target kiosky-player.service
Wants=network-online.target

# Production C18 V3: exact-target player-runtime auto-pull. This path never
# selects latest broadly; the updater must validate the local authorization.
ConditionPathExists=/opt/totem/bin/totem-updatectl
ConditionPathExists=/data/updates/player-runtime-production-autopull.json

[Service]
Type=oneshot
User=root
ExecStart=/opt/totem/bin/totem-updatectl apply-player-runtime-authorized --authorization /data/updates/player-runtime-production-autopull.json

# Best-effort isolation; /data must remain writable so updater can stage payloads.
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true

TimeoutStartSec=900
SuccessExitStatus=40 50

# Exit codes from totem-updatectl:
#   0 success/no-op ; 10/11 rejected candidate/rollback path ; 20 GitHub access
#   blocked; 40 deferred while settings owns the device;
#   44 missing/disabled authorization/frozen; 50 exact target not published yet;
#   49 update lock busy; 51 settings/systemd guard untrusted;
#   52 canonical update lock unavailable or untrusted.
RestartPreventExitStatus=10 11 20 44 49

# Static oneshot. The production image enables the paired timer.
