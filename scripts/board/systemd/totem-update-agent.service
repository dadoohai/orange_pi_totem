[Unit]
Description=Dadooh Totem Update Agent (manual core updater)
Documentation=https://github.com/dadoohai/orange_pi_totem
After=network-online.target
Wants=network-online.target

# C18 fail-safe: the unit only runs when the updater and explicit component
# policy are present. The timer is disabled by default; operators may start
# this oneshot manually for totem-core updates.
ConditionPathExists=/opt/totem/bin/totem-updatectl
ConditionPathExists=/data/updates/policy.json

[Service]
Type=oneshot
User=root
# Manual/operator-triggered core update with rollback on failed health check.
# The periodic timer is disabled in C18; kiosky-player/MPV/hwdecode are frozen
# out of OTA until a C18-aware player package exists.
ExecStart=/opt/totem/bin/totem-updatectl apply-github-latest --component totem-core --repo dadoohai/orange_pi_totem

# Best-effort isolation; /data must remain writable so updater can stage payloads.
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true

# Don't loop frantically if the network is down or GitHub is unreachable.
TimeoutStartSec=600

# Exit codes from totem-updatectl:
#   0 success ; 10 auto-rolled-back (still treated as failure for restart logic)
#   20 GitHub access blocked (private/forbidden) ; 21+ other errors
# The timer will retry on the next OnUnitActiveSec window regardless.
RestartPreventExitStatus=10 20

# No [Install] section: this is a static oneshot driven exclusively by
# totem-update-agent.timer (and by manual `systemctl start`). Enabling the
# timer is what makes the unit run periodically.
