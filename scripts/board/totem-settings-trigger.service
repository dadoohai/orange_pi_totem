[Unit]
Description=Dadooh Totem Settings Trigger
After=systemd-udevd.service local-fs.target totem-firstboot-gate.service
Wants=systemd-udevd.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/totem/bin/totem_settings_trigger.py --daemon --request-dir /run/dadooh-settings --hold-sec 5 --cooldown-sec 10 --session-lock /run/dadooh-settings/session.lock --open-service totem-open-settings.service
Restart=always
RestartSec=2
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
